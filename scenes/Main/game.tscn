[sub_resource type="Resource" id="Resource_bf74x"]
script = ExtResource("36_jcrwi")
date = "19/10/1447"
text = "	She collapsed today. Crumpled like a leaf before the statue. Her head cracked open on the base, splattering the thing with crimson. It stood there, unfazed, speckled with fresh blood. Blood that seeped through the floorboards, oozing into the earth below. Blood that coated my hands and robes as I kneeled shrieking beside her. So much blood from such a small body. It wouldn’t stop. It will never stop. In her coffin now, she bleeds. Bleeds until the box overflows with thick, sticky crimson. And still it doesn’t stop. She will never let it stop. I know in my heart that She looks upon us with that same unfazed expression, drenched in the blood of us all, uncaring and merciless all the while.

	I can’t enter that room anymore. Father Mason insisted he would clean it. He didn’t leave the room for hours, his sobs echoing through the vacant halls of the church. I think he, too, knows that She isn’t coming to save us. He called the guard to watch over our graveyard, rightfully worried that his mother’s grave may be desecrated. He hasn’t left his office since. A handful of my sisters still hold strong, but my fight is gone. I wish the best for you all."
signature = "Sister Aubrey"
metadata/_custom_type_script = "uid://cs8kccqb2huxb"

